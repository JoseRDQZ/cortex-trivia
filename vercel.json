{
  "version": 2,
  "builds": [
    {
      "src": "backend/python/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/python/*.py", "db/*.json"]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/start",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/session/(.*)",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/game/(.*)",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/results/(.*)",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/questions",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/question_banks",
      "dest": "backend/python/app.py"
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/\$1"
    }
  ]
}